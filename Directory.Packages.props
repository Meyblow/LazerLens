<Project>
  <!--
    Central Package Management: every PackageReference in the repo (host, launcher, plugins)
    resolves its version from here, so a version bump is a single edit instead of touching
    each plugin csproj. Exact versions keep restore reproducible.
  -->
  <PropertyGroup>
    <!-- Single source of truth for the version of every distributable package (osucc.Host,
         osucc.Build, the osucc dotnet tool and osucc.Templates); the csproj <Version> properties
         and the PackageVersion pins below all read it. To release: bump here, tag vX.Y.Z, CI
         publishes the tag. -->
    <OsuCcVersion>2.2.0</OsuCcVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="osucc.Host" Version="$(OsuCcVersion)" />
    <PackageVersion Include="osucc.Build" Version="$(OsuCcVersion)" />
    <PackageVersion Include="Lib.Harmony" Version="2.4.2" />
    <PackageVersion Include="ppy.osu.Game" Version="2026.702.1" />
    <PackageVersion Include="SharpCompress" Version="0.49.1" />
    <PackageVersion Include="DotMake.CommandLine" Version="3.5.0" />
    <PackageVersion Include="SixLabors.Fonts" Version="2.0.4" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
  </ItemGroup>
</Project>